# ── Core ────────────────────────────────────────────────
NODE_ENV=development
NUXT_PUBLIC_APP_URL=http://localhost:3000
# @flag db
# Placeholder is boot-safe: the app serves pages and non-DB routes, and
# DB calls only error at request time. Real Neon URL + `bun run db:push`
# when auth persistence is needed.
DATABASE_URL=postgres://user:pass@host/db
# @endflag db
# @flag auth
BETTER_AUTH_URL=http://localhost:3000
# Generated per-project at scaffold time — never reuse.
BETTER_AUTH_SECRET=generate-a-long-random-string
# @endflag auth
# @flag billing
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
NUXT_POLAR_PRODUCT_ID_MONTHLY=
# @endflag billing
# @flag email
RESEND_API_KEY=
EMAIL_FROM={{PROJECT_NAME}} <noreply@example.com>
# @endflag email
# @flag redis
REDIS_URL=
# @endflag redis
# @flag sentry
SENTRY_DSN=
# @endflag sentry
# @flag tests
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# @endflag tests
